<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_dog_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo physics simulation of the robot dog: MJCF generated from the URDF,
    sim node (IMU, ground truth, joint states, disturbances), launch file, tools.</description>
  <maintainer email="zerunwang@gatech.edu">Zerun Wang</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>robot_dog_hw</exec_depend>
  <exec_depend>robot_dog_control</exec_depend>
  <exec_depend>robot_dog_bringup</exec_depend>
  <exec_depend>robot_dog_description</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <!-- conda-forge mujoco-python -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smbus_compat</name>
  <version>0.1.0</version>
  <description>Top-level smbus module that re-exports smbus2 for the ros-humble-bno055 driver.</description>
  <maintainer email="zerunwang@gatech.edu">Zerun Wang</maintainer>
  <license>MIT</license>

  <!-- smbus2 comes from pixi.toml -->
  <exec_depend>python3-smbus2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

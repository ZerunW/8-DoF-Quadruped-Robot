<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_dog_hw</name>
  <version>0.1.0</version>
  <description>Hardware I/O for the robot dog: PCA9685 servo driver, IMU supervisor and tools.</description>
  <maintainer email="zerunwang@gatech.edu">Zerun Wang</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- conda-forge / PyPI via pixi.toml: smbus2, pyyaml -->
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

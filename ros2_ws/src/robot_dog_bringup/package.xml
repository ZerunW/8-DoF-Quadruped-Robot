<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_dog_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and the configuration file for the robot dog.</description>
  <maintainer email="zerunwang@gatech.edu">Zerun Wang</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_dog_hw</exec_depend>
  <exec_depend>robot_dog_control</exec_depend>
  <exec_depend>smbus_compat</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>robot_dog_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
